{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES5", "ES6"],
    "rootDir": "src",
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "removeComments": true,
    "declaration": true,
    "preserveConstEnums": true,
    "noEmitOnError": true,
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
